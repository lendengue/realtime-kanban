{
  "name": "@realtime-kanban/api",
  "version": "0.0.0",
  "private": true,
  "description": "realtime-kanban REST API (auth, workspaces, boards metadata, invitations).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@realtime-kanban/source --env-file-if-exists=.env src/server.ts",
    "db:seed": "tsx --conditions=@realtime-kanban/source --env-file-if-exists=.env src/scripts/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@realtime-kanban/db": "workspace:*",
    "@realtime-kanban/shared": "workspace:*",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.17",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@realtime-kanban/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.15.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
