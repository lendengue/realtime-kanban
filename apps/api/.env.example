# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://realtime_kanban:realtime_kanban@localhost:5432/realtime_kanban
WEB_ORIGIN=http://localhost:5173

# Must match apps/collab. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# Mailpit from docker-compose (web UI on http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=realtime-kanban <no-reply@realtime-kanban.local>
INVITATION_TTL_DAYS=7

# Login attempts per minute per IP + e-mail. Keep 5 outside automated test runs.
LOGIN_RATE_LIMIT_PER_MINUTE=5
