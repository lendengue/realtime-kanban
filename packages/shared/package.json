{
  "name": "@realtime-kanban/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, types, constants and error codes shared by realtime-kanban apps.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@realtime-kanban/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./access-token": {
      "@realtime-kanban/source": "./src/access-token.ts",
      "types": "./dist/access-token.d.ts",
      "default": "./dist/access-token.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@realtime-kanban/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
