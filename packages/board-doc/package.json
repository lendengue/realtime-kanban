{
  "name": "@realtime-kanban/board-doc",
  "version": "0.0.0",
  "private": true,
  "description": "Yjs board document schema and pure, testable operations.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@realtime-kanban/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
